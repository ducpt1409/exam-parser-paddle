# ============================================================
# Biến override cho docker-compose của AI service. Copy thành .env:
#   cp .env.docker.example .env
# Hạ tầng (MinIO + Mongo) ở stack RIÊNG exam_parser_infra → AI service kết nối qua host.
# User/password ở đây phải KHỚP với exam_parser_infra/.env.
# ============================================================

# --- MinIO (stack exam_parser_infra, qua host) ---
MINIO_ENDPOINT=host.docker.internal:9000
MINIO_ROOT_USER=admin           # dùng làm access key
MINIO_ROOT_PASSWORD=admin12345  # dùng làm secret key
MINIO_BUCKET=exam-parser
MINIO_PREFIX=exams/

# --- MongoDB (stack exam_parser_infra, qua host) ---
MONGO_URI=mongodb://admin:admin12345@host.docker.internal:27017/?authSource=admin
MONGO_DB=exam_parser
MONGO_COLLECTION=exams
