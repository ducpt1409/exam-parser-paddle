# ============================================================
# exam_parser_paddle - Environment Variables
# Copy file này thành .env và điền giá trị thực
# ============================================================

# --- MinIO ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=                  # Tạo từ MinIO Console (xem SETUP.md §10.3)
MINIO_SECRET_KEY=                  # Tạo từ MinIO Console
MINIO_BUCKET=exam-parser
MINIO_SECURE=false                 # true nếu MinIO chạy HTTPS
MINIO_ROOT_USER=admin              # Cho docker-compose
MINIO_ROOT_PASSWORD=admin12345     # Cho docker-compose (đổi cho production)

# --- Ollama (Vision LLM) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_VLM_MODEL=qwen3-vl:32b-instruct
OLLAMA_TIMEOUT=120                 # seconds

# --- PaddleOCR ---
# QUAN TRỌNG: RTX 5090 (Blackwell sm_120) hiện chưa được Paddle official support.
# → Default = false (CPU mode). Khi Paddle release Blackwell support → đổi true.
PADDLE_USE_GPU=false
PADDLE_OCR_LANG=vi                 # Vietnamese (auto multilingual với en)
PADDLE_DET_LIMIT_SIDE_LEN=2400     # Max input size cho detection
PADDLE_CPU_THREADS=8               # Tăng nếu CPU nhiều core (cho CPU mode)

# --- Pipeline ---
DEFAULT_DPI=300                    # Render PDF DPI
USE_VLM_VERIFICATION=true          # Bật VLM verify anchors
USE_VLM_TYPE_CLASSIFY=true         # Bật VLM classify type khi ambiguous
DESKEW_THRESHOLD_DEGREES=0.5       # Skip deskew nếu góc < threshold
WEBP_QUALITY=85                    # Quality khi save ảnh crop

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1                      # Tăng nếu cần parallel
CORS_ORIGINS=*                     # Comma-separated, * = all

# --- Logging ---
LOG_LEVEL=INFO                     # DEBUG / INFO / WARNING / ERROR
LOG_FILE=logs/app.log              # Để trống = chỉ stdout

# --- Storage paths (local fallback nếu không dùng MinIO) ---
LOCAL_OUTPUT_DIR=./output
TEMP_DIR=/tmp/exam_parser
